# ===========================================
# stockflow - Configuração do Cliente AWS (Ferreira Costa)
# ===========================================
# Copie para .env em /opt/apps/stockflow/cliente-aws/ no servidor e preencha.
# Nunca commitar .env com segredos reais.

# --- Banco de Dados ---
DB_USER=stockflow
DB_PASSWORD=TROCAR_SENHA_AQUI
DB_NAME=stockflow

# --- Segurança ---
# Gere com: openssl rand -base64 48
JWT_SECRET=TROCAR_JWT_SECRET_AQUI

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=stockflow <noreply@fcxlabs.com>

# --- URL da Aplicação ---
APP_URL=https://suprimentos.fcxlabs.com

# --- Porta do Frontend (host) ---
WEB_PORT=3008

# --- Primeiro administrador (cmd/seed-admin) ---
# Rodado automaticamente pelo pipeline de deploy a cada execução; idempotente
# (não faz nada se já existir uma conta 'adm' — só existe uma por instalação).
# Troque a senha no primeiro login.
ADMIN_NOME=Administrador
ADMIN_EMAIL=TROCAR_EMAIL_DO_ADMIN_AQUI
ADMIN_SENHA=TROCAR_SENHA_DO_ADMIN_AQUI

# --- Login federado via Keycloak (Story 1.9, AD-7) ---
# Realm real já roda nesta mesma máquina (iam.fcxlabs.com). TODAS vazias por
# padrão: sem IAM_BASE_URL o SSO fica desligado. Preencher só depois que um
# admin criar o client dedicado do stockflow no realm `ferreiracosta`
# (distinto de `fb-apu02`) -- ver spec-1-9 "operator_actions".
#   IAM_BASE_URL=https://iam.fcxlabs.com/realms/ferreiracosta
#   IAM_CLIENT_ID=stockflow
#   IAM_REDIRECT_URI=https://suprimentos.fcxlabs.com/auth/callback
#   IAM_ALLOWED_CLIENT_IDS=stockflow
#   IAM_SCOPES=openid profile email
IAM_BASE_URL=
IAM_CLIENT_ID=
IAM_REDIRECT_URI=
IAM_ALLOWED_CLIENT_IDS=
IAM_SCOPES=
